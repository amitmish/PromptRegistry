rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    // User Profile Rules
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio']);
    }

    function isValidUser(data) {
      return data.uid == request.auth.uid 
             && data.displayName is string && data.displayName.size() <= 50
             && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500))
             && (data.bio == null || (data.bio is string && data.bio.size() <= 500));
    }

    // Prompt Rules
    match /prompts/{promptId} {
      allow read: if true; // Publicly searchable
      allow create: if isSignedIn() && isVerified() && isValidPrompt(request.resource.data) && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        // Author update
        (isOwner(resource.data.authorId) && isValidPrompt(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'content', 'description', 'category', 'tags', 'authorPhotoURL', 'aiModel', 'resultImage']))
        ||
        // Like increment/decrement & likes array update
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'usageCount', 'likes']))
      );
      allow delete: if isOwner(resource.data.authorId);
    }

    function isValidPrompt(data) {
      return data.title is string && data.title.size() <= 100
             && data.content is string && data.content.size() <= 5000
             && data.description is string && data.description.size() <= 500
             && data.category is string && data.category.size() <= 50
             && data.tags is list && data.tags.size() <= 10
             && data.authorId == request.auth.uid
             && data.authorName is string && data.authorName.size() <= 50
             && (!('authorPhotoURL' in data) || data.authorPhotoURL == null || (data.authorPhotoURL is string && data.authorPhotoURL.size() <= 1000))
             && (!('likes' in data) || data.likes is list && data.likes.size() <= 10000)
             && (!('aiModel' in data) || data.aiModel == null || (data.aiModel is string && data.aiModel.size() <= 100))
             && (!('resultImage' in data) || data.resultImage == null || (data.resultImage is string && data.resultImage.size() <= 1000000));
    }

    // Obsolete likes subcollection (keeping for backward compatibility or just removing if sure)
    match /prompts/{promptId}/likes/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }
  }
}
